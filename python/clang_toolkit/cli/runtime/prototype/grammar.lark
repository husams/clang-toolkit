// Standalone experimental scripting grammar.  This is deliberately separate
// from the released console grammar.

start: program

program: separators? statement (separators statement)* separators?
        |                  -> empty_program

?statement: closed_statement | open_statement
?closed_statement: let_stmt
                  | runnable_definition
                  | handler_stmt
                  | flow_stmt
                  | print_stmt
                  | assign_stmt
                  | natural_call
                  | closed_expression
?open_statement: open_let_stmt
               | open_runnable_definition
               | open_print_stmt
               | target ASSIGN_OP open_assign_value -> assign_stmt
               | natural_call
               | open_expression

let_stmt.10: "let" pattern "=" let_value
open_let_stmt.10: "let" pattern "=" open_let_value -> let_stmt
?let_value: closed_expression | natural_call
?open_let_value: open_expression | natural_call
?open_assign_value: open_expression | natural_call
print_stmt.50: "print" closed_expression
open_print_stmt.50: "print" open_expression -> print_stmt
assign_stmt: target ASSIGN_OP assign_value
?assign_value: closed_expression | natural_call

runnable_definition.20: "let" CNAME "(" parameters? ")" "=" block
                      | "let" CNAME "(" parameters? ")" "=" closed_expression
open_runnable_definition.20: "let" CNAME "(" parameters? ")" "=" open_expression -> runnable_definition
inline_runnable: "(" parameters? ")" "="? closed_expression
inline_block_runnable.1: "(" parameters? ")" "="? block -> inline_runnable
open_inline_runnable: "(" parameters? ")" "="? open_expression -> inline_runnable

parameters: separators? parameter ("," separators? parameter)* ","? separators?
parameter: labeled_parameter
         | shorthand_parameter
         | shorthand_default_parameter
         | pattern ("=" expression)?
labeled_parameter: CNAME ":" CNAME ("=" expression)?
shorthand_parameter: CNAME ":"
shorthand_default_parameter: CNAME ":" "=" expression
?pattern: pattern_atom ":" pattern -> cons_pattern
        | pattern_atom
?pattern_atom: "(" separators? ")" -> empty_pattern
        | CNAME -> name_pattern
        | "_" -> discard_pattern
        | "(" pattern "," separators? ")" -> tuple_single_pattern
        | "(" pattern "," separators? pattern ("," separators? pattern)* ","? ")" -> tuple_pattern
        | "(" pattern ")" -> grouped_pattern
        | "[" separators? "]" -> empty_list_pattern
        | "[" separators? pattern ("," separators? pattern)* ","? separators? "]" -> list_pattern

clause_runnable: "{" separators? runnable_clause (separators runnable_clause)* separators? "}"
?runnable_clause: inline_runnable | inline_block_runnable

?expression: closed_expression | open_expression
?closed_expression: inline_runnable | closed_pipe_expr
?open_expression: open_inline_runnable | open_pipe_expr
closed_pipe_expr: closed_pipe_base (soft_newlines PIPE_OP soft_newlines pipe_stage)* recovery_tail? -> pipe_expr
open_pipe_expr: open_pipe_base (soft_newlines PIPE_OP soft_newlines pipe_stage)* recovery_tail? -> pipe_expr
?closed_pipe_base: conditional
                 | inline_block_runnable
                 | closed_if_expr
                 | closed_unless_expr
                 | closed_foreach_expr
                 | closed_while_expr
                 | closed_repeat_expr
?open_pipe_base: conditional
               | inline_block_runnable
               | open_if_expr
               | open_unless_expr
               | open_foreach_expr
               | open_while_expr
               | open_repeat_expr
?multiline_expression: inline_runnable
                    | open_inline_runnable
                    | open_pipe_base (soft_newlines PIPE_OP soft_newlines pipe_stage)* recovery_tail? -> pipe_expr
?pipe_stage: trailing_stage | named_call | natural_stage | reference
trailing_stage: (named_call | natural_stage | reference) clause_runnable
?conditional: recoverable -> recovery_expr
closed_if_expr: "if" expression closed_conditional_body closed_if_else -> if_expr
open_if_expr: "if" expression conditional_body -> if_expr
            | "if" expression closed_conditional_body open_if_else -> if_expr
closed_unless_expr: "unless" expression closed_conditional_body closed_if_else -> unless_expr
open_unless_expr: "unless" expression conditional_body -> unless_expr
                | "unless" expression closed_conditional_body open_if_else -> unless_expr
closed_if_else: separators? "else" closed_else_body -> if_else
open_if_else: separators? "else" open_else_body -> if_else
closed_else_body: "do" closed_statement -> single_else_body
                | "do"? block -> block_else_body
                | closed_statement -> statement_else_body
open_else_body: "do" open_statement -> single_else_body
              | open_statement -> statement_else_body
closed_conditional_body: "do" closed_statement -> single_body
                       | "then" closed_statement -> single_body
                       | "do"? block -> block_body
                       | "then" block -> block_body
conditional_body: "do" statement -> single_body
                | "then" statement -> single_body
                | "do"? block -> block_body
                | "then" block -> block_body

closed_foreach_expr.10: "foreach" pattern PRED_IN expression closed_body -> foreach_expr
open_foreach_expr.10: "foreach" pattern PRED_IN expression open_body -> foreach_expr
closed_while_expr.10: "while" expression closed_body -> while_expr
open_while_expr.10: "while" expression open_body -> while_expr
closed_repeat_expr.10: "repeat" repeat_body soft_newlines "until" closed_expression -> repeat_expr
open_repeat_expr.10: "repeat" repeat_body soft_newlines "until" open_expression -> repeat_expr
repeat_body: block -> block_body
           | statement -> single_body

closed_body: "do" closed_statement -> single_body
           | "do"? block -> block_body
open_body: "do" open_statement -> single_body

block: "{" block_contents? "}"
block_contents: separators? statement (separators statement)* separators?

handler_stmt.30: "on" "error" handler_action -> error_handler
               | "on" "exit" handler_action -> exit_handler
?handler_action: handler_block | conditional | flow_stmt
handler_block.30: block
flow_stmt.30: "break" -> break_stmt
            | "continue" -> continue_stmt

recovery_tail: "on" "error" handler_action
?recoverable: or_expr
            | or_expr soft_newlines "?" soft_newlines conditional soft_newlines ":" soft_newlines conditional -> conditional
?or_expr: and_expr (soft_newlines PRED_OR soft_newlines and_expr)*
?and_expr: not_expr (soft_newlines PRED_AND soft_newlines not_expr)*
?not_expr: PRED_NOT soft_newlines not_expr  -> not_expr
         | comparison
comparison: additive comparison_tail?
?comparison_tail: soft_newlines COMPARE_OP soft_newlines additive -> comparison_tail
                | soft_newlines PRED_HAS soft_newlines has_key -> has_tail
                | soft_newlines PRED_DOES soft_newlines PRED_NOT soft_newlines PRED_HAVE soft_newlines has_key -> does_not_have_tail
                | soft_newlines PRED_IN soft_newlines additive -> in_tail
                | soft_newlines PRED_NOT soft_newlines PRED_IN soft_newlines additive -> not_in_tail
                | soft_newlines PRED_IS soft_newlines PRED_NOT soft_newlines PRED_DEFINED -> is_not_defined_tail
                | soft_newlines PRED_IS soft_newlines PRED_DEFINED -> is_defined_tail
                | soft_newlines PRED_IS soft_newlines PRED_NOT soft_newlines PRED_SET -> is_not_set_tail
                | soft_newlines PRED_IS soft_newlines PRED_SET -> is_set_tail
                | soft_newlines PRED_IS soft_newlines PRED_NOT soft_newlines CNAME -> is_not_kind_tail
                | soft_newlines PRED_IS soft_newlines CNAME -> is_kind_tail
?has_key: CNAME -> bare_key
        | PREDICATE_STRING -> predicate_string_literal
        | grouped_expression
?additive: multiplicative (soft_newlines ADD_OP soft_newlines multiplicative)*
?multiplicative: unary (soft_newlines MUL_OP soft_newlines unary)*
?unary: UNARY_OP unary       -> unary_expr
      | postfix
?postfix: atom postfix_part*

?postfix_part: soft_newlines "." soft_newlines CNAME -> member_part
             | index_expression
             | call_suffix
             | clause_runnable -> trailing_block_part
call_suffix.2: "(" arguments? ")"

target: reference target_part*
?target_part: "." CNAME       -> target_member_part
           | index_expression

reference: "$"? CNAME

?atom: literal
     | clause_runnable
     | reference
     | named_call
     | list_literal
     | dict_literal
     | tuple_literal
     | grouped_expression

// Whitespace calls are deliberately a separate, bounded form. The callee
// and labels require horizontal space through their token lookaheads; values
// are ordinary atomic/postfix expressions or explicitly grouped expressions.
natural_call: NATURAL_NAME natural_value? natural_labeled_argument+
            | NATURAL_NAME natural_simple_value
natural_stage: NATURAL_STAGE_NAME natural_labeled_argument+
natural_labeled_argument: NATURAL_LABEL natural_value
?natural_simple_value: literal
                     | natural_reference_postfix
                     | natural_named_call
natural_reference_postfix: natural_value_reference natural_postfix_part*
?natural_value: UNARY_OP natural_postfix -> unary_expr
              | natural_postfix
?natural_postfix: natural_atom natural_postfix_part*
?natural_atom: literal
             | clause_runnable
             | natural_value_reference
             | natural_named_call
             | list_literal
             | dict_literal
             | tuple_literal
             | grouped_expression
natural_value_reference: "$"? NATURAL_VALUE_NAME -> reference
natural_named_call.3: NATURAL_ROUTINE_NAME "(" arguments? ")" -> named_call
?natural_postfix_part: "." CNAME -> member_part
                     | index_expression
                     | call_suffix

named_call.3: CNAME "(" arguments? ")"
arguments: separators? argument ("," separators? argument)* ","? separators?
?argument: CNAME "=" expression -> keyword_argument
         | expression

index_expression: "[" separators? expression separators? "]"
                | "[" separators? slice_bound ":" slice_bound (":" slice_bound)? "]" -> slice_expression
slice_bound: separators? expression? separators?

grouped_expression.2: "(" inner_expression ")"
inner_expression: separators? multiline_expression separators?
tuple_literal.2: "(" separators? ")" -> empty_tuple
             | "(" separators? expression separators? "," separators? expression ("," separators? expression)* ","? separators? ")" -> tuple_items
             | "(" separators? expression separators? "," separators? ")" -> tuple_singleton

list_literal: "[" list_items? "]"
list_items: separators? expression ("," separators? expression)* ","? separators?

dict_literal: "{" dict_items? "}"
dict_items: separators? dict_item ("," separators? dict_item)* ","? separators?
dict_item: key ":" expression
?key: STRING
    | CNAME

literal: INT       -> integer_literal
        | FLOAT     -> float_literal
        | STRING    -> string_literal
        | "true"    -> true_literal
        | "false"   -> false_literal
        | "null"    -> null_literal

separators: separator+
?separator: NEWLINE | ";"
soft_newlines: NEWLINE*

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
PIPE_OP: "|"
COMPARE_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "+" | "-"

FLOAT: /(?:[0-9]+\.[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+/
INT: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
PREDICATE_STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
CNAME: /[A-Za-z_][A-Za-z0-9_]*/
NATURAL_NAME.20: /(?<![A-Za-z0-9_])(?!(?:let|print|if|unless|foreach|while|repeat|break|continue|on|and|or|not|in|is|then|do|else|until|has|does|have|defined|set|true|false|null|parse|read|load|save|import|background|yield|match|inspect|clear|add|history|session|server|index|cache|bindings|binding|cfg|variableflow|callgraph|help|traverse|peek|step|script|cursor|file|resource|batch|pop|delete|push|insert|remove|split|join|flatten|quit|exit)\b)[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])(?=[ \t])/
NATURAL_STAGE_NAME.20: /(?<![A-Za-z0-9_])(?!(?:let|print|if|unless|foreach|while|repeat|break|continue|on|and|or|not|in|is|then|do|else|until|has|does|have|defined|set|true|false|null)\b)[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])(?=[ \t])/
NATURAL_LABEL.20: /(?<![A-Za-z0-9_])(?!(?:let|print|if|unless|foreach|while|repeat|break|continue|on|and|or|not|in|is|then|do|else|until|has|does|have|defined|set|true|false|null)\b)[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])(?=[ \t])/
NATURAL_VALUE_NAME.20: /(?<![A-Za-z0-9_])(?!(?:let|print|if|unless|foreach|while|repeat|break|continue|on|and|or|not|in|is|then|do|else|until|has|does|have|defined|set|true|false|null)\b)[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])/
NATURAL_ROUTINE_NAME.20: /(?<![A-Za-z0-9_])(?!(?:let|print|if|unless|foreach|while|repeat|break|continue|on|and|or|not|in|is|then|do|else|until|has|does|have|defined|set|true|false|null)\b)[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])(?=\s*\()/
PRED_HAS: /(?<![A-Za-z0-9_])has(?![A-Za-z0-9_])/
PRED_DOES: /(?<![A-Za-z0-9_])does(?![A-Za-z0-9_])/
PRED_HAVE: /(?<![A-Za-z0-9_])have(?![A-Za-z0-9_])/
PRED_IN: /(?<![A-Za-z0-9_])in(?![A-Za-z0-9_])/
PRED_IS: /(?<![A-Za-z0-9_])is(?![A-Za-z0-9_])/
PRED_NOT: /(?<![A-Za-z0-9_])not(?![A-Za-z0-9_])/
PRED_DEFINED: /(?<![A-Za-z0-9_])defined(?![A-Za-z0-9_])/
PRED_SET: /(?<![A-Za-z0-9_])set(?![A-Za-z0-9_])/
PRED_AND: /(?<![A-Za-z0-9_])and(?![A-Za-z0-9_])/
PRED_OR: /(?<![A-Za-z0-9_])or(?![A-Za-z0-9_])/
NEWLINE: /\r?\n/

%import common.WS_INLINE
%ignore WS_INLINE
%ignore /\/\/[^\r\n]*/
