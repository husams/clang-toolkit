start: statement SEMICOLON? BATCH_SEPARATOR?
batch_start: batch_separator* statement (batch_separator+ statement)* batch_separator*
batch_separator: BATCH_SEPARATOR+ | SEMICOLON BATCH_SEPARATOR*
reference_start: reference

?statement: assignment
          | command
          | reference                    -> display
          | STRING                       -> display
          | foreach_expression           -> display
          | parse_expression             -> display
          | read_expression              -> display
          | analysis_block               -> display

assignment: LET NAME EQUAL value_expression

?command: MATCH root_expression [IN path_value_expression] [DO statement_block] -> match
        | BACKGROUND root_expression [IN path_value_expression] -> background
        | PRINT value_expression [TO output_path [MODE (REPLACE | APPEND)]] -> print
        | INSPECT reference              -> inspect
        | SET USER? setting              -> set_command
        | CLEAR USER? NAME               -> clear_command
        | ADD EXTRA_ARG STRING           -> add_arg
        | SAVE reference TO output_path [AS NAME] -> save_command
        | LOAD output_path INTO reference -> load_command
        | HISTORY SAVE FILE_STRING       -> history_save
        | HISTORY CLEAR                  -> history_clear
        | SESSION LABEL STRING           -> session_label
        | SESSION START STRING           -> session_start
        | SESSION ADD FILE_STRING        -> session_add
        | SESSION MATCH                  -> session_match
        | SESSION PAUSE                  -> session_pause
        | SESSION RESUME                 -> session_resume
        | SESSION CLOSE                  -> session_close
        | SESSION CLOSE (STRING | reference) -> session_close_retained
        | SESSION LIST                   -> session_list
        | SESSION ATTACH (STRING | reference) INTO reference -> session_attach
        | SERVER STATUS                  -> server_status
        | CACHE STATUS                   -> cache_status
        | CACHE PRUNE NAME?              -> cache_prune
        | BINDINGS                       -> bindings_list
        | BINDINGS LIST                  -> bindings_list
        | BINDING DROP reference         -> binding_drop
        | BINDING RENAME reference TO reference -> binding_rename
        | CFG cfg_expression            -> cfg
        | CFG cfg_expression IN path_target_expression cfg_option* graph_option* -> cfg_file
        | CALLGRAPH -> callgraph
        | CALLGRAPH path_target_expression call_graph_option* graph_option* -> callgraph_file
        | HELP help_topic?               -> help
        | HELP_SHORT_TOPIC QUESTION      -> help_shortcut
        | QUIT                           -> quit
        | EXIT                           -> exit
        | TRAVERSE path_target_expression traverse_option* graph_option* -> traverse
        | SCRIPT target_expression (IN path_target_expression)? -> script
        | CURSOR OPEN FILE_STRING root_expression cursor_option* -> cursor_open
        | CURSOR CONTINUE STRING STRING root_expression cursor_option* -> cursor_continue
        | CURSOR RESTART STRING root_expression cursor_option* -> cursor_restart
        | CURSOR CLOSE STRING -> cursor_close

help_topic: HELP_WORD+

cursor_option: ROW NUMBER -> cursor_row
             | CURSOR_SCOPE NAME -> cursor_scope
             | REVISION NUMBER -> cursor_revision

call_graph_option: NODES NUMBER -> call_graph_nodes
                 | EDGES NUMBER -> call_graph_edges
                 | IMPLICIT (TRUE | FALSE) -> call_graph_implicit
                 | INSTANTIATIONS (TRUE | FALSE) -> call_graph_instantiations

cfg_option: OPTION NAME (TRUE | FALSE) -> cfg_build_option
          | FUNCTIONS NUMBER -> cfg_functions
          | BLOCKS NUMBER -> cfg_blocks
          | ELEMENTS NUMBER -> cfg_elements

traverse_option: DEPTH NUMBER -> traverse_depth
               | NODES NUMBER -> traverse_nodes
               | IMPLICIT (TRUE | FALSE) -> traverse_implicit
               | INSTANTIATIONS (TRUE | FALSE) -> traverse_instantiations

?setting: TRAVERSAL NAME                 -> traversal_setting
        | EXTRA_ARGS list_value          -> args_setting
        | COMPILE_COMMANDS STRING        -> compilation_database_setting
        | CACHE_DIR TO DIRECTORY_STRING  -> cache_setting
        | FILES TO path_value_expression -> files_setting
        | OUTPUT TO (output_path | STDOUT) [MODE (REPLACE | APPEND)] -> output_setting

?output_path: FILE_STRING | reference

?value_expression: root_expression
                 | STRING
                 | NUMBER
                 | TRUE                    -> true
                 | FALSE                   -> false
                 | list_value
                 | grouped_expression
                 | glob_call
                 | match_expression
                 | foreach_expression
                 | parse_expression
                 | read_expression
                 | analysis_block
                 | traverse_expression
                 | call_graph_expression
                 | cfg_file_expression

// Distinct string roles tell the editor which arguments accept filesystem paths.
// They share the same quoting syntax and evaluate to ordinary string values.
?path_value_expression: root_expression
                      | FILE_STRING
                      | NUMBER
                      | TRUE -> true
                      | FALSE -> false
                      | path_list_value
                      | grouped_expression
                      | glob_call
                      | match_expression
                      | foreach_expression
                      | parse_expression
                      | analysis_block
                      | traverse_expression
                      | call_graph_expression
                      | cfg_file_expression
path_list_value: LSQB [path_value_expression (COMMA path_value_expression)*] RSQB -> list_value
?path_target_expression: target_matcher
                       | reference
                       | qualified_name
                       | NAME
                       | FILE_STRING
                       | NUMBER

match_expression: MATCH root_expression [IN path_value_expression]
parse_expression: PARSE path_target_expression
read_expression: READ output_path
analysis_block: IN BATCH_SEPARATOR* (parse_expression | reference) BATCH_SEPARATOR* LBRACE BATCH_SEPARATOR* (assignment (SEMICOLON | BATCH_SEPARATOR)+)* YIELD yield_expression SEMICOLON? BATCH_SEPARATOR* RBRACE
statement_block: LBRACE BATCH_SEPARATOR* (statement (SEMICOLON | BATCH_SEPARATOR)+)* statement? RBRACE
?yield_expression: value_expression
                 | NAME -> named_value
foreach_expression: FOREACH reference BATCH_SEPARATOR* IN BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DO BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DONE?
traverse_expression: TRAVERSE path_target_expression traverse_option* graph_option* -> traverse_expression
call_graph_expression: CALLGRAPH path_target_expression call_graph_option* graph_option* -> call_graph_expression
cfg_file_expression: CFG target_expression IN path_target_expression cfg_option* graph_option* -> cfg_file_expression
graph_option: PROJECTION NAME -> graph_projection
            | MAIN_FILE (TRUE | FALSE) -> graph_main_file
            | PAYLOAD_DEPTH NUMBER -> graph_payload_depth
            | PAYLOAD_NODES NUMBER -> graph_payload_nodes
list_value: LSQB [value_expression (COMMA value_expression)*] RSQB
grouped_expression: LPAR value_expression RPAR grouped_suffix* -> grouped_expression
grouped_suffix: DOT NAME -> grouped_property
              | DOT method_call -> grouped_method
              | LSQB index_expression RSQB -> grouped_index
?index_expression: NEGATIVE_NUMBER
                 | NUMBER
                 | STRING
                 | reference
                 | grouped_expression
glob_call: GLOB LPAR PATH_STRING RPAR

?root_expression: root_matcher
                | reference

root_matcher: ROOT_MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher

?arguments: argument (COMMA argument)*

?argument: nested_matcher
         | reference
         | nested_qualified_name
         | STRING
         | NUMBER
         | TRUE                           -> true
         | FALSE                          -> false
         | list_value

nested_matcher: MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher
nested_qualified_name: (NAME | MATCHER_NAME) (SCOPE (NAME | MATCHER_NAME))+

bind: BIND LPAR STRING RPAR

?cfg_expression: target_expression

?target_expression: target_matcher
                  | reference
                  | qualified_name
                  | NAME
                  | STRING
                  | NUMBER

target_matcher: NAME LPAR [target_arguments] RPAR bind? -> matcher

target_arguments: target_expression (COMMA target_expression)*

reference: DOLLAR NAME (DOT NAME | DOT method_call | LSQB index_expression RSQB)*
?method_call: HAS_FIELD LPAR STRING RPAR -> has_field_call
            | FIELD_STATE LPAR STRING RPAR -> field_state_call
            | FIELD_OR LPAR STRING COMMA value_expression RPAR -> field_or_call
            | method_name LPAR method_arguments RPAR -> generic_method_call
method_name: NAME | JOIN_WITH | UNIQUE | SORT | FILTER
method_arguments: value_expression (COMMA value_expression)*
qualified_name: NAME (SCOPE NAME)+

// Keep the editor lexer lossless, including strings open at end of input.
editor_start: editor_token*

?editor_token: LET
             | READ
             | PARSE
             | YIELD
             | MATCH
             | BACKGROUND
             | PRINT
             | INSPECT
             | FOREACH
             | IN
             | DO
             | DONE
             | GLOB
             | TRUE
             | FALSE
             | SET
             | CLEAR
             | ADD
             | EXTRA_ARG
             | COMPILE_COMMANDS
             | EXTRA_ARGS
             | TRAVERSAL
             | CACHE_DIR
             | FILES
             | OUTPUT
             | STDOUT
             | SAVE
             | LOAD
             | TO
             | AS
             | INTO
             | USER
             | HISTORY
             | SESSION
             | LIST
             | ATTACH
             | SERVER
             | STATUS
             | CACHE
             | PRUNE
             | BINDINGS
             | BINDING
             | DROP
             | RENAME
             | LABEL
             | START
             | PAUSE
             | RESUME
             | CLOSE
             | MODE
             | REPLACE
             | APPEND
             | JOIN_WITH
             | HAS_FIELD
             | FIELD_STATE
             | FIELD_OR
             | UNIQUE
             | SORT
             | FILTER
             | CFG
             | CALLGRAPH
             | HELP
             | QUIT
             | EXIT
             | TRAVERSE
             | PROJECTION
             | MAIN_FILE
             | PAYLOAD_DEPTH
             | PAYLOAD_NODES
             | DEPTH
             | NODES
             | IMPLICIT
             | INSTANTIATIONS
             | SCRIPT
             | CURSOR
             | OPEN
             | CONTINUE
             | RESTART
             | ROW
             | CURSOR_SCOPE
             | REVISION
             | EDITOR_NAME
             | NAME
             | STRING
             | FILE_STRING
             | DIRECTORY_STRING
             | PATH_STRING
             | OPEN_STRING
             | HELP_WORD
             | HELP_SHORT_TOPIC
             | QUESTION
             | NUMBER
             | BIND
             | DOLLAR
             | DOT
             | SCOPE
             | EQUAL
             | LPAR
             | RPAR
             | LSQB
             | RSQB
             | LBRACE
             | RBRACE
             | COMMA
             | SEMICOLON
             | BATCH_SEPARATOR
             | WS
             | ERROR

LET.2: /let(?![a-zA-Z0-9_])/
PARSE.2: /parse(?![a-zA-Z0-9_])/
YIELD.2: /yield(?![a-zA-Z0-9_])/
MATCH.2: /match(?![a-zA-Z0-9_])/
BACKGROUND.2: /background(?![a-zA-Z0-9_])/
PRINT.2: /print(?![a-zA-Z0-9_])/
INSPECT.2: /inspect(?![a-zA-Z0-9_])/
FOREACH.2: /foreach(?![a-zA-Z0-9_])/
IN.2: /in(?![a-zA-Z0-9_])/
DO.2: /do(?![a-zA-Z0-9_])/
DONE.2: /done(?![a-zA-Z0-9_])/
GLOB.3: /glob(?![a-zA-Z0-9_])/
