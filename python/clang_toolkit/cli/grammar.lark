start: statement SEMICOLON? BATCH_SEPARATOR?
batch_start: batch_separator* statement (batch_separator+ statement)* batch_separator*
batch_separator: BATCH_SEPARATOR+ | SEMICOLON BATCH_SEPARATOR*
reference_start: reference

?statement: assignment
          | matcher_definition
          | command_expression
          | collection_command
          | QUIT                            -> quit
          | EXIT                            -> exit
          | display_expression              -> display

assignment: LET NAME EQUAL value_expression
matcher_definition: LET NAME LPAR [parameters] RPAR EQUAL root_expression
parameters: NAME (COMMA NAME)*

?command_expression: MATCH root_expression [IN path_value_expression] [DO statement_block] -> match
        | BACKGROUND root_expression [IN path_value_expression] -> background
        | PRINT value_expression [TO output_path [MODE (REPLACE | APPEND)]] -> print
        | INSPECT reference              -> inspect
        | SET mutation_target EQUAL value_expression -> set_item_command
        | SET USER? setting              -> set_command
        | CLEAR USER? NAME               -> clear_command
        | ADD EXTRA_ARG STRING           -> add_arg
        | SAVE value_expression TO output_path [AS NAME] -> save_command
        | LOAD output_path [INTO reference] -> load_command
        | HISTORY SAVE FILE_STRING       -> history_save
        | HISTORY CLEAR                  -> history_clear
        | SESSION LABEL STRING           -> session_label
        | SESSION START STRING           -> session_start
        | SESSION ADD FILE_STRING        -> session_add
        | SESSION MATCH                  -> session_match
        | SESSION PAUSE                  -> session_pause
        | SESSION RESUME                 -> session_resume
        | SESSION CLOSE                  -> session_close
        | SESSION CLOSE (STRING | reference) -> session_close_retained
        | SESSION LIST                   -> session_list
        | SESSION ATTACH (STRING | reference) INTO reference -> session_attach
        | SERVER STATUS                  -> server_status
        | CACHE STATUS                   -> cache_status
        | CACHE PRUNE NAME?              -> cache_prune
        | BINDINGS                       -> bindings_list
        | BINDINGS LIST                  -> bindings_list
        | BINDING DROP reference         -> binding_drop
        | BINDING RENAME reference TO reference -> binding_rename
        | CFG cfg_expression            -> cfg
        | CFG cfg_expression IN path_target_expression cfg_option* graph_option* -> cfg_file
        | CALLGRAPH -> callgraph
        | CALLGRAPH path_target_expression call_graph_option* graph_option* -> callgraph_file
        | HELP help_topic?               -> help
        | HELP_SHORT_TOPIC QUESTION      -> help_shortcut
        | TRAVERSE path_target_expression traverse_option* graph_option* -> traverse
        | SCRIPT target_expression (IN path_target_expression)? -> script
        | CURSOR OPEN FILE_STRING root_expression cursor_option* -> cursor_open
        | CURSOR CONTINUE STRING STRING root_expression cursor_option* -> cursor_continue
        | CURSOR RESTART STRING root_expression cursor_option* -> cursor_restart
        | CURSOR CLOSE STRING -> cursor_close
        | IMPORT FILE_STRING -> import_command
        | FILE OPEN path_value_expression [INTO reference] -> file_open
        | FILE LIST [DISCOVERED IN reference] -> file_list
        | FILE INFO value_expression -> file_info
        | FILE CLOSE (value_expression | ALL) -> file_close
        | FILE REFRESH value_expression [INTO reference] -> file_refresh
        | RESOURCE STATUS -> resource_status
        | batch_statement

?collection_command: PUSH collection_ref COMMA value_expression -> push_command
                   | PUSH collection_ref WITH value_expression -> push_command
                   | DELETE collection_ref -> delete_command

help_topic: HELP_WORD+

cursor_option: ROW NUMBER -> cursor_row
             | CURSOR_SCOPE NAME -> cursor_scope
             | REVISION NUMBER -> cursor_revision

call_graph_option: NODES NUMBER -> call_graph_nodes
                 | EDGES NUMBER -> call_graph_edges
                 | IMPLICIT (TRUE | FALSE) -> call_graph_implicit
                 | INSTANTIATIONS (TRUE | FALSE) -> call_graph_instantiations

cfg_option: OPTION NAME (TRUE | FALSE) -> cfg_build_option
          | FUNCTIONS NUMBER -> cfg_functions
          | BLOCKS NUMBER -> cfg_blocks
          | ELEMENTS NUMBER -> cfg_elements

traverse_option: DEPTH NUMBER -> traverse_depth
               | NODES NUMBER -> traverse_nodes
               | IMPLICIT (TRUE | FALSE) -> traverse_implicit
               | INSTANTIATIONS (TRUE | FALSE) -> traverse_instantiations

?setting: TRAVERSAL NAME                 -> traversal_setting
        | EXTRA_ARGS list_value          -> args_setting
        | COMPILE_COMMANDS STRING        -> compilation_database_setting
        | CACHE_DIR TO DIRECTORY_STRING  -> cache_setting
        | FILES TO path_value_expression -> files_setting
        | OUTPUT TO (output_path | STDOUT) [MODE (REPLACE | APPEND)] -> output_setting

?output_path: FILE_STRING | reference

?value_expression: root_expression
                 | bare_value
                 | STRING
                 | NUMBER
                 | TRUE                    -> true
                 | FALSE                   -> false
                 | list_value
                 | grouped_expression
                 | glob_call
                 | foreach_expression
                 | foreach_statement_expression
                 | parse_expression
                 | read_expression
                 | file_set_expression
                 | analysis_block
                 | dict_value
                 | pop_expression
                 | split_expression
                 | join_expression
                 | collection_command
                 | command_expression

// Commands keep their historical top-level node shape; bare values display.
?display_expression: reference
                   | bare_access
                   | STRING
                   | NUMBER
                   | TRUE                    -> true
                   | FALSE                   -> false
                   | list_value
                   | grouped_expression
                   | glob_call
                   | foreach_expression
                   | foreach_statement_expression
                   | parse_expression
                   | read_expression
                   | file_set_expression
                   | analysis_block
                   | dict_value
                   | pop_expression
                   | split_expression
                   | join_expression

// Distinct string roles tell the editor which arguments accept filesystem paths.
// They share the same quoting syntax and evaluate to ordinary string values.
?path_value_expression: root_expression
                      | FILE_STRING
                      | NUMBER
                      | TRUE -> true
                      | FALSE -> false
                      | path_list_value
                      | grouped_expression
                      | glob_call
                      | file_set_expression
                      | foreach_expression
                      | foreach_statement_expression
                      | parse_expression
                      | analysis_block
                      | dict_value
                      | pop_expression
                      | split_expression
                      | join_expression
                      | command_expression
path_list_value: LSQB [path_value_expression (COMMA path_value_expression)*] RSQB -> list_value
file_set_expression: FILES_EXPR path_value_expression -> files_expression
batch_statement: BATCH NAME IN reference batch_grouping batch_option* DO statement_block
batch_grouping: SIZE NUMBER -> batch_size
              | COUNT NUMBER -> batch_count
batch_option: JOBS NUMBER -> batch_jobs
            | MEMORY STRING -> batch_memory
            | ON ERROR_WORD (STOP | CONTINUE) -> batch_error_mode
            | PROGRESS (ON | OFF) -> batch_progress
?path_target_expression: target_matcher
                       | reference
                       | qualified_name
                       | NAME
                       | FILE_STRING
                       | NUMBER

parse_expression: PARSE path_target_expression
read_expression: READ output_path
analysis_block: IN BATCH_SEPARATOR* (parse_expression | reference) BATCH_SEPARATOR* LBRACE BATCH_SEPARATOR* (assignment (SEMICOLON | BATCH_SEPARATOR)+)* YIELD yield_expression SEMICOLON? BATCH_SEPARATOR* RBRACE
statement_block: LBRACE BATCH_SEPARATOR* (statement (SEMICOLON | BATCH_SEPARATOR)+)* statement? RBRACE
?yield_expression: value_expression
foreach_expression: FOREACH reference BATCH_SEPARATOR* IN BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DO BATCH_SEPARATOR* foreach_statement_block
                 | FOREACH reference BATCH_SEPARATOR* IN BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DO BATCH_SEPARATOR* foreach_empty_block
                 | FOREACH reference BATCH_SEPARATOR* IN BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DO BATCH_SEPARATOR* value_expression (DONE | DONE_AFTER_NEWLINE)?
foreach_statement_expression: FOREACH NAME BATCH_SEPARATOR* IN BATCH_SEPARATOR* value_expression BATCH_SEPARATOR* DO BATCH_SEPARATOR* (foreach_statement_block | foreach_empty_block | value_expression (DONE | DONE_AFTER_NEWLINE)?)
foreach_statement_block: LBRACE BATCH_SEPARATOR* statement ((SEMICOLON | BATCH_SEPARATOR)+ statement)* (SEMICOLON | BATCH_SEPARATOR)* RBRACE
foreach_empty_block: LBRACE BATCH_SEPARATOR+ RBRACE
graph_option: PROJECTION NAME -> graph_projection
            | MAIN_FILE (TRUE | FALSE) -> graph_main_file
            | PAYLOAD_DEPTH NUMBER -> graph_payload_depth
            | PAYLOAD_NODES NUMBER -> graph_payload_nodes
list_value: LSQB [value_expression (COMMA value_expression)*] RSQB
dict_value: LBRACE [dict_entry (COMMA dict_entry)*] RBRACE
dict_entry: (STRING | collection_name) COLON value_expression
?collection_name: NAME | USER | FILES | TRAVERSAL | EXTRA_ARGS | COMPILE_COMMANDS | CACHE_DIR | OUTPUT | PUSH | POP | DELETE | SPLIT | JOIN | BY | WITH | INSERT | REMOVE | CLEAR | IMPORT
bare_value: collection_name (DOT collection_name | LSQB index_expression RSQB)*
bare_access: collection_name (DOT collection_name | LSQB index_expression RSQB)+
?collection_ref: bare_value | reference
?mutation_target: MUTATION_NAME (DOT collection_name | LSQB index_expression RSQB)+ | reference
pop_expression: POP collection_ref
split_expression: SPLIT value_expression BY value_expression
join_expression: JOIN collection_ref WITH value_expression
grouped_expression: LPAR value_expression RPAR grouped_suffix* -> grouped_expression
grouped_suffix: DOT NAME -> grouped_property
              | DOT method_call -> grouped_method
              | LSQB index_expression RSQB -> grouped_index
?index_expression: NEGATIVE_NUMBER
                 | NUMBER
                 | STRING
                 | reference
                 | grouped_expression
glob_call: GLOB LPAR PATH_STRING RPAR

?root_expression: root_matcher
                | reference

root_matcher: ROOT_MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher

?arguments: argument (COMMA argument)*

?argument: nested_matcher
         | reference
         | nested_qualified_name
         | STRING
         | NUMBER
         | TRUE                           -> true
         | FALSE                          -> false
         | list_value

nested_matcher: MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher
nested_qualified_name: (NAME | MATCHER_NAME) (SCOPE (NAME | MATCHER_NAME))+

bind: BIND LPAR STRING RPAR

?cfg_expression: target_expression

?target_expression: target_matcher
                  | reference
                  | qualified_name
                  | NAME
                  | STRING
                  | NUMBER

target_matcher: NAME LPAR [target_arguments] RPAR bind? -> matcher

target_arguments: target_expression (COMMA target_expression)*

reference: DOLLAR NAME (DOT property_name | DOT method_call | LSQB index_expression RSQB)*
?property_name: NAME | PUSH | POP | DELETE | SPLIT | JOIN | BY | WITH | INSERT | REMOVE | CLEAR | IMPORT | OUTPUT | FILES | TRAVERSAL | EXTRA_ARGS | COMPILE_COMMANDS | CACHE_DIR | USER
?method_call: HAS_FIELD LPAR STRING RPAR -> has_field_call
            | FIELD_STATE LPAR STRING RPAR -> field_state_call
            | FIELD_OR LPAR STRING COMMA value_expression RPAR -> field_or_call
            | method_name LPAR [method_arguments] RPAR -> generic_method_call
method_name: NAME | JOIN_WITH | UNIQUE | SORT | FILTER | PUSH | POP | DELETE | SET | INSERT | REMOVE | CLEAR
method_arguments: value_expression (COMMA value_expression)*
qualified_name: NAME (SCOPE NAME)+

// Keep the editor lexer lossless, including strings open at end of input.
editor_start: editor_token*

?editor_token: LET
             | READ
             | PARSE
             | YIELD
             | MATCH
             | BACKGROUND
             | PRINT
             | INSPECT
             | FOREACH
             | IN
             | DO
             | DONE
             | GLOB
             | TRUE
             | FALSE
             | SET
             | CLEAR
             | ADD
             | EXTRA_ARG
             | COMPILE_COMMANDS
             | EXTRA_ARGS
             | TRAVERSAL
             | CACHE_DIR
             | FILES
             | OUTPUT
             | STDOUT
             | SAVE
             | LOAD
             | TO
             | AS
             | INTO
             | USER
             | HISTORY
             | SESSION
             | LIST
             | ATTACH
             | SERVER
             | STATUS
             | CACHE
             | PRUNE
             | BINDINGS
             | BINDING
             | DROP
             | RENAME
             | LABEL
             | START
             | PAUSE
             | RESUME
             | CLOSE
             | MODE
             | REPLACE
             | APPEND
             | JOIN_WITH
             | HAS_FIELD
             | FIELD_STATE
             | FIELD_OR
             | UNIQUE
             | SORT
             | FILTER
             | PUSH
             | POP
             | DELETE
             | SPLIT
             | JOIN
             | BY
             | WITH
             | INSERT
             | REMOVE
             | CLEAR
             | IMPORT
             | MUTATION_NAME
             | CFG
             | CALLGRAPH
             | HELP
             | QUIT
             | EXIT
             | PROGRESS
             | OFF
             | TRAVERSE
             | PROJECTION
             | MAIN_FILE
             | PAYLOAD_DEPTH
             | PAYLOAD_NODES
             | DEPTH
             | NODES
             | IMPLICIT
             | INSTANTIATIONS
             | SCRIPT
             | CURSOR
             | OPEN
             | CONTINUE
             | RESTART
             | ROW
             | CURSOR_SCOPE
             | REVISION
             | EDITOR_NAME
             | NAME
             | STRING
             | FILE_STRING
             | DIRECTORY_STRING
             | PATH_STRING
             | OPEN_STRING
             | HELP_WORD
             | HELP_SHORT_TOPIC
             | QUESTION
             | NUMBER
             | BIND
             | DOLLAR
             | DOT
             | SCOPE
             | EQUAL
             | LPAR
             | RPAR
             | LSQB
             | RSQB
             | LBRACE
             | RBRACE
             | COMMA
             | COLON
             | SEMICOLON
             | BATCH_SEPARATOR
             | WS
             | ERROR

LET.2: /let(?![a-zA-Z0-9_])/
PARSE.2: /parse(?![a-zA-Z0-9_])/
YIELD.2: /yield(?![a-zA-Z0-9_])/
MATCH.2: /match(?![a-zA-Z0-9_])/
BACKGROUND.2: /background(?![a-zA-Z0-9_])/
PRINT.2: /print(?![a-zA-Z0-9_])/
INSPECT.2: /inspect(?![a-zA-Z0-9_])/
FOREACH.2: /foreach(?![a-zA-Z0-9_])/
IN.2: /in(?![a-zA-Z0-9_])/
DO.2: /do(?![a-zA-Z0-9_])/
DONE.2: /done(?![a-zA-Z0-9_])/
DONE_AFTER_NEWLINE.3: /(?:\r?\n[ \t]*(?:\#[^\r\n]*)?)+done(?![a-zA-Z0-9_])/
GLOB.3: /glob(?![a-zA-Z0-9_])/
TRUE.2: /true(?![a-zA-Z0-9_])/
FALSE.2: /false(?![a-zA-Z0-9_])/
SET.2: /set(?![a-zA-Z0-9_])/
CLEAR.2: /clear(?![a-zA-Z0-9_])/
ADD.2: /add(?![a-zA-Z0-9_])/
EXTRA_ARG.2: /extra_arg(?![a-zA-Z0-9_])/
EXTRA_ARGS.2: /extra_args(?![a-zA-Z0-9_])/
TRAVERSAL.2: /traversal(?![a-zA-Z0-9_])/
CACHE_DIR.2: /cache_dir(?![a-zA-Z0-9_])/
FILES.2: /files(?![a-zA-Z0-9_])/
FILES_EXPR.3: /files(?=\s+["'\[])/
OUTPUT.2: /output(?![a-zA-Z0-9_])/
STDOUT.2: /stdout(?![a-zA-Z0-9_])/
SAVE.2: /save(?![a-zA-Z0-9_])/
LOAD.2: /load(?![a-zA-Z0-9_])/
READ.2: /read(?![a-zA-Z0-9_])/
TO.2: /to(?![a-zA-Z0-9_])/
AS.2: /as(?![a-zA-Z0-9_])/
INTO.2: /into(?![a-zA-Z0-9_])/
USER.2: /user(?![a-zA-Z0-9_])/
HISTORY.2: /history(?![a-zA-Z0-9_])/
SESSION.2: /session(?![a-zA-Z0-9_])/
LIST.2: /list(?![a-zA-Z0-9_])/
ATTACH.2: /attach(?![a-zA-Z0-9_])/
SERVER.2: /server(?![a-zA-Z0-9_])/
STATUS.2: /status(?![a-zA-Z0-9_])/
CACHE.2: /cache(?![a-zA-Z0-9_])/
PRUNE.2: /prune(?![a-zA-Z0-9_])/
BINDINGS.2: /bindings(?![a-zA-Z0-9_])/
BINDING.2: /binding(?![a-zA-Z0-9_])/
DROP.2: /drop(?![a-zA-Z0-9_])/
RENAME.2: /rename(?![a-zA-Z0-9_])/
LABEL.2: /label(?![a-zA-Z0-9_])/
START.2: /start(?![a-zA-Z0-9_])/
PAUSE.2: /pause(?![a-zA-Z0-9_])/
RESUME.2: /resume(?![a-zA-Z0-9_])/
CLOSE.2: /close(?![a-zA-Z0-9_])/
MODE.2: /mode(?![a-zA-Z0-9_])/
REPLACE.3: /replace(?![a-zA-Z0-9_])/
APPEND.3: /append(?![a-zA-Z0-9_])/
JOIN_WITH.3: /joinWith(?![a-zA-Z0-9_])/
IMPORT.2: /import(?![a-zA-Z0-9_])/
PUSH.2: /push(?![a-zA-Z0-9_])/
POP.2: /pop(?![a-zA-Z0-9_])/
DELETE.2: /delete(?![a-zA-Z0-9_])/
INSERT.2: /insert(?![a-zA-Z0-9_])/
REMOVE.2: /remove(?![a-zA-Z0-9_])/
SPLIT.2: /split(?![a-zA-Z0-9_])/
JOIN.2: /join(?![a-zA-Z0-9_])/
BY.2: /by(?![a-zA-Z0-9_])/
WITH.2: /with(?![a-zA-Z0-9_])/
MUTATION_NAME.4: /[a-zA-Z_][a-zA-Z0-9_]*(?=\s*(?:\[[^\]\r\n]*\]\s*)+=)/
HAS_FIELD.3: /hasField(?![a-zA-Z0-9_])/
FIELD_STATE.3: /fieldState(?![a-zA-Z0-9_])/
FIELD_OR.3: /fieldOr(?![a-zA-Z0-9_])/
UNIQUE.3: /unique(?![a-zA-Z0-9_])/
SORT.3: /sort(?![a-zA-Z0-9_])/
FILTER.3: /filter(?![a-zA-Z0-9_])/
CFG.2: /cfg(?![a-zA-Z0-9_])/
CALLGRAPH.2: /callgraph(?![a-zA-Z0-9_])/
HELP.2: /help(?![a-zA-Z0-9_])/
QUIT.2: /quit(?![a-zA-Z0-9_])/
EXIT.2: /exit(?![a-zA-Z0-9_])/
TRAVERSE.2: /traverse(?![a-zA-Z0-9_])/
PROJECTION.2: /projection(?![a-zA-Z0-9_])/
MAIN_FILE.2: /main-file(?![a-zA-Z0-9_])/
PAYLOAD_DEPTH.2: /payload-depth(?![a-zA-Z0-9_])/
PAYLOAD_NODES.2: /payload-nodes(?![a-zA-Z0-9_])/
DEPTH.2: /depth(?![a-zA-Z0-9_])/
NODES.2: /nodes(?![a-zA-Z0-9_])/
IMPLICIT.2: /implicit(?![a-zA-Z0-9_])/
INSTANTIATIONS.2: /instantiations(?![a-zA-Z0-9_])/
SCRIPT.2: /script(?![a-zA-Z0-9_])/
CURSOR.2: /cursor(?![a-zA-Z0-9_])/
OPEN.2: /open(?![a-zA-Z0-9_])/
CONTINUE.2: /continue(?![a-zA-Z0-9_])/
RESTART.2: /restart(?![a-zA-Z0-9_])/
ROW.2: /row(?![a-zA-Z0-9_])/
CURSOR_SCOPE.2: /scope(?![a-zA-Z0-9_])/
REVISION.2: /revision(?![a-zA-Z0-9_])/

ROOT_MATCHER_NAME: /[a-zA-Z_][a-zA-Z0-9_]*(?=\s*\()/
MATCHER_NAME: /[a-zA-Z_][a-zA-Z0-9_]*(?=\s*\()/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
EDITOR_NAME.10: /[a-zA-Z_][a-zA-Z0-9_]*/
BIND.3: /\.bind(?![a-zA-Z0-9_])/
STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
FILE_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
DIRECTORY_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
PATH_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
HELP_WORD: /[a-zA-Z_][a-zA-Z0-9_]*/
HELP_SHORT_TOPIC.4: /[a-zA-Z_][a-zA-Z0-9_]*(?:[ \t]+[a-zA-Z_][a-zA-Z0-9_]*)*(?=[ \t]*\?)/
QUESTION: "?"
OPEN_STRING.2: /"(?:\\.|[^"\\])*(?:\\)?$/s | /'(?:\\.|[^'\\])*(?:\\)?$/s
DOLLAR: "$"
DOT: "."
SCOPE: "::"
EQUAL: "="
LPAR: "("
RPAR: ")"
LSQB: "["
RSQB: "]"
LBRACE: "{"
RBRACE: "}"
COMMA: ","
COLON: ":"
SEMICOLON: ";"
BATCH_SEPARATOR.1: /\r?\n+/
COMMENT: /#[^\r\n]*/
WS: /[ \t\r]+/
ERROR: /[\s\S]/

%ignore WS
%ignore COMMENT

%import common.NUMBER
NEGATIVE_NUMBER.2: /-[0-9]+(?:\.[0-9]*)?(?:[eE][+-]?[0-9]+)?/

OPTION.2: /option(?![a-zA-Z0-9_])/
FUNCTIONS.2: /functions(?![a-zA-Z0-9_])/
BLOCKS.2: /blocks(?![a-zA-Z0-9_])/
ELEMENTS.2: /elements(?![a-zA-Z0-9_])/

EDGES.2: /edges(?![a-zA-Z0-9_])/

COMPILE_COMMANDS.2: /compile_commands(?![a-zA-Z0-9_])/
FILE.2: /file(?![a-zA-Z0-9_])/
RESOURCE.2: /resource(?![a-zA-Z0-9_])/
BATCH.2: /batch(?![a-zA-Z0-9_])/
SIZE.2: /size(?![a-zA-Z0-9_])/
COUNT.2: /count(?![a-zA-Z0-9_])/
JOBS.2: /jobs(?![a-zA-Z0-9_])/
MEMORY.2: /memory(?![a-zA-Z0-9_])/
ON.2: /on(?![a-zA-Z0-9_])/
OFF.2: /off(?![a-zA-Z0-9_])/
PROGRESS.2: /progress(?![a-zA-Z0-9_])/
ERROR_WORD.2: /error(?![a-zA-Z0-9_])/
STOP.2: /stop(?![a-zA-Z0-9_])/
ALL.2: /all(?![a-zA-Z0-9_])/
DISCOVERED.2: /discovered(?![a-zA-Z0-9_])/
INFO.2: /info(?![a-zA-Z0-9_])/
REFRESH.2: /refresh(?![a-zA-Z0-9_])/
