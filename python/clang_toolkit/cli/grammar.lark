start: statement SEMICOLON?
reference_start: reference

?statement: assignment
          | command
          | reference                    -> display
          | STRING                       -> display
          | foreach_expression           -> display
          | parse_expression             -> display
          | analysis_block               -> display

assignment: LET NAME EQUAL value_expression

?command: MATCH root_expression [IN path_value_expression] -> match
        | BACKGROUND root_expression [IN path_value_expression] -> background
        | PRINT value_expression         -> print
        | SET USER? setting              -> set_command
        | CLEAR USER? NAME               -> clear_command
        | ADD EXTRA_ARG STRING           -> add_arg
        | SAVE reference TO FILE_STRING [AS NAME] -> save_command
        | LOAD FILE_STRING INTO reference -> load_command
        | HISTORY SAVE FILE_STRING       -> history_save
        | HISTORY CLEAR                  -> history_clear
        | SESSION LABEL STRING           -> session_label
        | SESSION START STRING           -> session_start
        | SESSION ADD FILE_STRING        -> session_add
        | SESSION MATCH                  -> session_match
        | SESSION PAUSE                  -> session_pause
        | SESSION RESUME                 -> session_resume
        | SESSION CLOSE                  -> session_close
        | CFG cfg_expression            -> cfg
        | CFG cfg_expression IN path_target_expression cfg_option* -> cfg_file
        | CALLGRAPH -> callgraph
        | CALLGRAPH path_target_expression call_graph_option* -> callgraph_file
        | HELP help_topic?               -> help
        | HELP_SHORT_TOPIC QUESTION      -> help_shortcut
        | QUIT                           -> quit
        | EXIT                           -> exit
        | TRAVERSE path_target_expression traverse_option* -> traverse
        | SCRIPT target_expression (IN path_target_expression)? -> script
        | CURSOR OPEN FILE_STRING root_expression cursor_option* -> cursor_open
        | CURSOR CONTINUE STRING STRING root_expression cursor_option* -> cursor_continue
        | CURSOR RESTART STRING root_expression cursor_option* -> cursor_restart
        | CURSOR CLOSE STRING -> cursor_close

help_topic: HELP_WORD+

cursor_option: ROW NUMBER -> cursor_row
             | CURSOR_SCOPE NAME -> cursor_scope
             | REVISION NUMBER -> cursor_revision

call_graph_option: NODES NUMBER -> call_graph_nodes
                 | EDGES NUMBER -> call_graph_edges
                 | IMPLICIT (TRUE | FALSE) -> call_graph_implicit
                 | INSTANTIATIONS (TRUE | FALSE) -> call_graph_instantiations

cfg_option: OPTION NAME (TRUE | FALSE) -> cfg_build_option
          | FUNCTIONS NUMBER -> cfg_functions
          | BLOCKS NUMBER -> cfg_blocks
          | ELEMENTS NUMBER -> cfg_elements

traverse_option: DEPTH NUMBER -> traverse_depth
               | NODES NUMBER -> traverse_nodes
               | IMPLICIT (TRUE | FALSE) -> traverse_implicit
               | INSTANTIATIONS (TRUE | FALSE) -> traverse_instantiations

?setting: TRAVERSAL NAME                 -> traversal_setting
        | EXTRA_ARGS list_value          -> args_setting
        | CACHE_DIR TO DIRECTORY_STRING  -> cache_setting
        | FILES TO path_value_expression -> files_setting
        | OUTPUT TO (FILE_STRING | STDOUT) [MODE REPLACE] -> output_setting

?value_expression: root_expression
                 | STRING
                 | NUMBER
                 | TRUE                    -> true
                 | FALSE                   -> false
                 | list_value
                 | glob_call
                 | match_expression
                 | foreach_expression
                 | parse_expression
                 | analysis_block

// Distinct string roles tell the editor which arguments accept filesystem paths.
// They share the same quoting syntax and evaluate to ordinary string values.
?path_value_expression: root_expression
                      | FILE_STRING
                      | NUMBER
                      | TRUE -> true
                      | FALSE -> false
                      | path_list_value
                      | glob_call
                      | match_expression
                      | foreach_expression
                      | parse_expression
                      | analysis_block
path_list_value: LSQB [path_value_expression (COMMA path_value_expression)*] RSQB -> list_value
?path_target_expression: target_matcher
                       | reference
                       | qualified_name
                       | NAME
                       | FILE_STRING
                       | NUMBER

match_expression: MATCH root_expression [IN path_value_expression]
parse_expression: PARSE path_target_expression
analysis_block: IN (parse_expression | reference) LBRACE (assignment SEMICOLON)* YIELD yield_expression SEMICOLON? RBRACE
?yield_expression: value_expression
                 | NAME -> named_value
foreach_expression: FOREACH reference IN value_expression DO value_expression DONE?
list_value: LSQB [value_expression (COMMA value_expression)*] RSQB
glob_call: GLOB LPAR PATH_STRING RPAR

?root_expression: root_matcher
                | reference

root_matcher: ROOT_MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher

?arguments: argument (COMMA argument)*

?argument: nested_matcher
         | reference
         | nested_qualified_name
         | STRING
         | NUMBER
         | TRUE                           -> true
         | FALSE                          -> false
         | list_value

nested_matcher: MATCHER_NAME LPAR [arguments] RPAR bind? -> matcher
nested_qualified_name: (NAME | MATCHER_NAME) (SCOPE (NAME | MATCHER_NAME))+

bind: BIND LPAR STRING RPAR

?cfg_expression: target_expression

?target_expression: target_matcher
                  | reference
                  | qualified_name
                  | NAME
                  | STRING
                  | NUMBER

target_matcher: NAME LPAR [target_arguments] RPAR bind? -> matcher

target_arguments: target_expression (COMMA target_expression)*

reference: DOLLAR NAME (DOT NAME | DOT JOIN_WITH LPAR value_expression RPAR | LSQB NUMBER RSQB)*
qualified_name: NAME (SCOPE NAME)+

// Keep the editor lexer lossless, including strings open at end of input.
editor_start: editor_token*

?editor_token: LET
             | PARSE
             | YIELD
             | MATCH
             | BACKGROUND
             | PRINT
             | FOREACH
             | IN
             | DO
             | DONE
             | GLOB
             | TRUE
             | FALSE
             | SET
             | CLEAR
             | ADD
             | EXTRA_ARG
             | EXTRA_ARGS
             | TRAVERSAL
             | CACHE_DIR
             | FILES
             | OUTPUT
             | STDOUT
             | SAVE
             | LOAD
             | TO
             | AS
             | INTO
             | USER
             | HISTORY
             | SESSION
             | LABEL
             | START
             | PAUSE
             | RESUME
             | CLOSE
             | MODE
             | REPLACE
             | JOIN_WITH
             | CFG
             | CALLGRAPH
             | HELP
             | QUIT
             | EXIT
             | TRAVERSE
             | DEPTH
             | NODES
             | IMPLICIT
             | INSTANTIATIONS
             | SCRIPT
             | CURSOR
             | OPEN
             | CONTINUE
             | RESTART
             | ROW
             | CURSOR_SCOPE
             | REVISION
             | EDITOR_NAME
             | NAME
             | STRING
             | FILE_STRING
             | DIRECTORY_STRING
             | PATH_STRING
             | OPEN_STRING
             | HELP_WORD
             | HELP_SHORT_TOPIC
             | QUESTION
             | NUMBER
             | BIND
             | DOLLAR
             | DOT
             | SCOPE
             | EQUAL
             | LPAR
             | RPAR
             | LSQB
             | RSQB
             | LBRACE
             | RBRACE
             | COMMA
             | SEMICOLON
             | WS
             | ERROR

LET.2: /let(?![a-zA-Z0-9_])/
PARSE.2: /parse(?![a-zA-Z0-9_])/
YIELD.2: /yield(?![a-zA-Z0-9_])/
MATCH.2: /match(?![a-zA-Z0-9_])/
BACKGROUND.2: /background(?![a-zA-Z0-9_])/
PRINT.2: /print(?![a-zA-Z0-9_])/
FOREACH.2: /foreach(?![a-zA-Z0-9_])/
IN.2: /in(?![a-zA-Z0-9_])/
DO.2: /do(?![a-zA-Z0-9_])/
DONE.2: /done(?![a-zA-Z0-9_])/
GLOB.3: /glob(?![a-zA-Z0-9_])/
TRUE.2: /true(?![a-zA-Z0-9_])/
FALSE.2: /false(?![a-zA-Z0-9_])/
SET.2: /set(?![a-zA-Z0-9_])/
CLEAR.2: /clear(?![a-zA-Z0-9_])/
ADD.2: /add(?![a-zA-Z0-9_])/
EXTRA_ARG.2: /extra_arg(?![a-zA-Z0-9_])/
EXTRA_ARGS.2: /extra_args(?![a-zA-Z0-9_])/
TRAVERSAL.2: /traversal(?![a-zA-Z0-9_])/
CACHE_DIR.2: /cache_dir(?![a-zA-Z0-9_])/
FILES.2: /files(?![a-zA-Z0-9_])/
OUTPUT.2: /output(?![a-zA-Z0-9_])/
STDOUT.2: /stdout(?![a-zA-Z0-9_])/
SAVE.2: /save(?![a-zA-Z0-9_])/
LOAD.2: /load(?![a-zA-Z0-9_])/
TO.2: /to(?![a-zA-Z0-9_])/
AS.2: /as(?![a-zA-Z0-9_])/
INTO.2: /into(?![a-zA-Z0-9_])/
USER.2: /user(?![a-zA-Z0-9_])/
HISTORY.2: /history(?![a-zA-Z0-9_])/
SESSION.2: /session(?![a-zA-Z0-9_])/
LABEL.2: /label(?![a-zA-Z0-9_])/
START.2: /start(?![a-zA-Z0-9_])/
PAUSE.2: /pause(?![a-zA-Z0-9_])/
RESUME.2: /resume(?![a-zA-Z0-9_])/
CLOSE.2: /close(?![a-zA-Z0-9_])/
MODE.2: /mode(?![a-zA-Z0-9_])/
REPLACE.3: /replace(?![a-zA-Z0-9_])/
JOIN_WITH.3: /joinWith(?![a-zA-Z0-9_])/
CFG.2: /cfg(?![a-zA-Z0-9_])/
CALLGRAPH.2: /callgraph(?![a-zA-Z0-9_])/
HELP.2: /help(?![a-zA-Z0-9_])/
QUIT.2: /quit(?![a-zA-Z0-9_])/
EXIT.2: /exit(?![a-zA-Z0-9_])/
TRAVERSE.2: /traverse(?![a-zA-Z0-9_])/
DEPTH.2: /depth(?![a-zA-Z0-9_])/
NODES.2: /nodes(?![a-zA-Z0-9_])/
IMPLICIT.2: /implicit(?![a-zA-Z0-9_])/
INSTANTIATIONS.2: /instantiations(?![a-zA-Z0-9_])/
SCRIPT.2: /script(?![a-zA-Z0-9_])/
CURSOR.2: /cursor(?![a-zA-Z0-9_])/
OPEN.2: /open(?![a-zA-Z0-9_])/
CONTINUE.2: /continue(?![a-zA-Z0-9_])/
RESTART.2: /restart(?![a-zA-Z0-9_])/
ROW.2: /row(?![a-zA-Z0-9_])/
CURSOR_SCOPE.2: /scope(?![a-zA-Z0-9_])/
REVISION.2: /revision(?![a-zA-Z0-9_])/

ROOT_MATCHER_NAME: /[a-zA-Z_][a-zA-Z0-9_]*(?=\s*\()/
MATCHER_NAME: /[a-zA-Z_][a-zA-Z0-9_]*(?=\s*\()/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
EDITOR_NAME.10: /[a-zA-Z_][a-zA-Z0-9_]*/
BIND.3: /\.bind(?![a-zA-Z0-9_])/
STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
FILE_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
DIRECTORY_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
PATH_STRING.3: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/s
HELP_WORD: /[a-zA-Z_][a-zA-Z0-9_]*/
HELP_SHORT_TOPIC.4: /[a-zA-Z_][a-zA-Z0-9_]*(?:[ \t]+[a-zA-Z_][a-zA-Z0-9_]*)*(?=[ \t]*\?)/
QUESTION: "?"
OPEN_STRING.2: /"(?:\\.|[^"\\])*(?:\\)?$/s | /'(?:\\.|[^'\\])*(?:\\)?$/s
DOLLAR: "$"
DOT: "."
SCOPE: "::"
EQUAL: "="
LPAR: "("
RPAR: ")"
LSQB: "["
RSQB: "]"
LBRACE: "{"
RBRACE: "}"
COMMA: ","
SEMICOLON: ";"
WS: /\s+/
ERROR: /[\s\S]/

%ignore WS

%import common.NUMBER

OPTION.2: /option(?![a-zA-Z0-9_])/
FUNCTIONS.2: /functions(?![a-zA-Z0-9_])/
BLOCKS.2: /blocks(?![a-zA-Z0-9_])/
ELEMENTS.2: /elements(?![a-zA-Z0-9_])/

EDGES.2: /edges(?![a-zA-Z0-9_])/
