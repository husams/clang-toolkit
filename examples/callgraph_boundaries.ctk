// Run from the repository root; user headers stay in the graph.
let filename = callgraph "examples/callgraph_boundaries.cc" exclude-system true
print "FILENAME_NODES={filename.nodes.length}"
let tree = parse "examples/callgraph_boundaries.cc"
let parsed = callgraph in tree exclude-system true
print "PARSED_NODES={parsed.nodes.length}"
let entries = match functionDecl(hasName("entry"), isDefinition()).bind("f") in tree
let shallow = callgraph in entries[0].f exclude-system true
print "MATCHED_DEFAULT_DEPTH_NODES={shallow.nodes.length}"
let matched = callgraph in entries[0].f exclude-system true depth all
print "MATCHED_NODES={matched.nodes.length}"
foreach edge in matched.edges do {
    if not edge.is_virtual_root_edge then {
        print "{matched.nodes[edge.caller_node].function.qualified_name} -> {matched.nodes[edge.callee_node].function.qualified_name}"
    }
}
// Exclude a namespace too; Clang matcher combinators support custom rules.
let custom = callgraph in entries[0].f exclude-system true depth all node-filter 'functionDecl(unless(matchesName("(^|::)vendor::")))'
print "CUSTOM_NODES={custom.nodes.length}"
foreach node in custom.nodes do {
    if not node.is_virtual_root then { print node.function.qualified_name }
}
print "COMPLETE={custom.is_complete}"
