let xs = [10, 20, 30, 40, 50]
print xs[-1]
print xs[1:4] | json
print xs[-3:] | json
print xs[::2] | json
print xs[::-1] | json
print xs[3::-1] | json
print xs[:-1:-1] | json
print xs | first
print xs | last
print xs | first(2) | json
print xs | last(2) | json
print xs | last(0) | json
print [] | first | json
print [] | last | json
print xs | reverse | first(2) | json
